 <div id="auth" style="display:none">
   <div id="authBox">
@@ -122,5 +122,5 @@
 <script src="/js/attachments.js"></script>
 <script src="/js/push.js"></script>
 <script src="/js/socket.js"></script>
-<script src="/js/calls.js?v=5"></script>
