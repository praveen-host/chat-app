From f8374b125d3c480bafa1815122ea11e26bf5f01f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 14:23:20 +0000
Subject: [PATCH] Keep calls alive through network drops (auto-reconnect)

- Server: answered calls get a 45s grace period when a socket drops; new call:rejoin
  re-attaches a reconnected socket; call:restart-request relays callee -> caller.
- Client: a dropped socket no longer ends an answered call; on reconnect it rejoins and
  the caller restarts ICE on the same peer connection. Reconnecting UI + 60s give-up.
- Diagnostics: logs the media path (relay/srflx/host) once connected.
- Does not touch /api/call-config, server.js or any TURN settings.
---
 public/css/styles.css |   4 ++
 public/index.html     |   4 +-
 public/js/calls.js    | 136 ++++++++++++++++++++++++++++++++++++++++--
 src/socket/calls.js   |  45 ++++++++++++++
 4 files changed, 182 insertions(+), 7 deletions(-)

diff --git a/public/css/styles.css b/public/css/styles.css
index 1470e91..a7c04fe 100644
--- a/public/css/styles.css
+++ b/public/css/styles.css
@@ -445,3 +445,7 @@ body { color: #182338; letter-spacing: .01em; }
   #callOverlay.call-vid.call-incoming #callMsg { order: 2; width: 54px; }
   #callOverlay.call-vid.call-incoming #callAccept { order: 3; }
 }
+
+/* ---- Reconnecting: dim the picture while the connection recovers ---- */
+#callOverlay.call-reconnecting #remoteCallVideo { filter: blur(6px) brightness(.55); transition: filter .3s; }
+#callOverlay.call-reconnecting #callStatus { font-weight: 600; }
